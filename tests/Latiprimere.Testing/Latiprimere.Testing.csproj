<Project Sdk="Microsoft.NET.Sdk">

	<!-- Fixtures shared by the test projects: the shared test documents, the environment variables that switch on the
	     integration tests, a printer catalog built the way applications build it, and waits for jobs and output files -->

	<!-- Latiprimere from its project, or in the end-to-end harness's packaged mode from the packed package
	     (tests/Directory.Build.props) -->
	<ItemGroup Condition="'$(LatiprimereFromPackages)' == ''">
		<ProjectReference Include="..\..\src\Latiprimere\Latiprimere.csproj" />
	</ItemGroup>

	<ItemGroup Condition="'$(LatiprimereFromPackages)' != ''">
		<PackageReference Include="Latiprimere" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" />
	</ItemGroup>

	<!-- The shared test documents, copied into Data/ here and in every project that references this one -->
	<ItemGroup>
		<None Include="..\..\tools\test-documents\*.pdf" Link="Data\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\tools\test-documents\*.png;..\..\tools\test-documents\*.jpg;..\..\tools\test-documents\*.txt" Link="Data\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
