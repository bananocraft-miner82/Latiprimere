<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Description>CUPS adapter for Latiprimere: print through the CUPS scheduler on Linux and macOS, or through a CUPS print server from any platform.</Description>
		<PackageTags>$(PackageTags);linux;macos</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Latiprimere.Abstractions\Latiprimere.Abstractions.csproj" />
		<ProjectReference Include="..\Latiprimere.Ipp\Latiprimere.Ipp.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
		<!-- Diagnostics, when the application registers logging -->
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Latiprimere.Cups.Tests" />
	</ItemGroup>

	<!-- Exception messages; the source generator gives them strongly typed classes the editor sees without a build -->
	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.ResxSourceGenerator" PrivateAssets="all" />
	</ItemGroup>

</Project>
