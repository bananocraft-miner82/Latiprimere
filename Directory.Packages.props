<Project>

	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>

	<!-- Analyzers applied to every project -->
	<ItemGroup>
		<GlobalPackageReference Include="StyleCop.Analyzers" Version="1.3.180" />
	</ItemGroup>

	<!-- Library dependencies -->
	<ItemGroup>
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
		<PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
		<PackageVersion Include="SharpIppNext" Version="5.0.3" />
		<PackageVersion Include="Tmds.MDns" Version="0.10.1" />
		<PackageVersion Include="Microsoft.CodeAnalysis.ResxSourceGenerator" Version="3.11.0-beta1.26226.5" />
		<PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
		<PackageVersion Include="bblanchon.PDFium.Win32" Version="160.0.8179" />
		<PackageVersion Include="bblanchon.PDFium.Linux" Version="160.0.8179" />
		<PackageVersion Include="bblanchon.PDFium.macOS" Version="160.0.8179" />
	</ItemGroup>

	<!-- Test dependencies -->
	<ItemGroup>
		<PackageVersion Include="xunit.v3" Version="4.0.3" />
	</ItemGroup>

	<!-- Latiprimere's own packages, for the end-to-end harness's packaged mode only (tests/Directory.Build.props) -->
	<ItemGroup Condition="'$(LatiprimereFromPackages)' != '' and '$(LatiprimerePackageVersion)' != ''">
		<PackageVersion Include="Latiprimere" Version="$(LatiprimerePackageVersion)" />
		<PackageVersion Include="Latiprimere.Cups" Version="$(LatiprimerePackageVersion)" />
		<PackageVersion Include="Latiprimere.Ipp" Version="$(LatiprimerePackageVersion)" />
		<PackageVersion Include="Latiprimere.Rendering.Pdfium" Version="$(LatiprimerePackageVersion)" />
		<PackageVersion Include="Latiprimere.Windows" Version="$(LatiprimerePackageVersion)" />
	</ItemGroup>

</Project>
