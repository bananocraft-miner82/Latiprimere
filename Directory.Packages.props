<Project>

	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>

	<!-- Analyzers applied to every project -->
	<ItemGroup>
		<GlobalPackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" />
	</ItemGroup>

	<!-- Library dependencies -->
	<ItemGroup>
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
		<PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
		<PackageVersion Include="SharpIppNext" Version="5.0.2" />
		<PackageVersion Include="Tmds.MDns" Version="0.10.1" />
		<PackageVersion Include="Microsoft.CodeAnalysis.ResxSourceGenerator" Version="3.11.0-beta1.26226.5" />
		<PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
		<PackageVersion Include="bblanchon.PDFium.Win32" Version="158.0.8125" />
		<PackageVersion Include="bblanchon.PDFium.Linux" Version="158.0.8125" />
		<PackageVersion Include="bblanchon.PDFium.macOS" Version="158.0.8125" />
	</ItemGroup>

	<!-- Test dependencies -->
	<ItemGroup>
		<PackageVersion Include="xunit.v3" Version="4.0.2" />
	</ItemGroup>

</Project>
