<?xml version="1.0" encoding="utf-8"?>
<!--
	Latiprimere restores packages from nuget.org only. Clearing inherited sources keeps builds reproducible for
	every contributor and CI, regardless of machine-level NuGet configuration.
-->
<configuration>
	<packageSources>
		<clear />
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
	</packageSources>
	<packageSourceMapping>
		<clear />
		<packageSource key="nuget.org">
			<package pattern="*" />
		</packageSource>
	</packageSourceMapping>
</configuration>
